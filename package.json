{
  "name": "ai-community-impact-tracker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 5174 --strictPort",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "ci": "npm run typecheck && npm run lint && npm run build",
    "clean": "rm -rf dist release",
    "release": "npm run clean && npm run ci && mkdir -p release && STAMP=$(date -u +'%Y-%m-%dT%H-%M-%SZ') && cd dist && zip -r ../release/communityimpact-$STAMP.zip . && cd .. && echo Release created"
  },
  "dependencies": {
    "@headlessui/react": "^1.7.17",
    "@sentry/react": "^10.39.0",
    "@supabase/supabase-js": "^2.38.0",
    "clsx": "^2.0.0",
    "date-fns": "^3.0.6",
    "ethers": "^6.8.0",
    "framer-motion": "^10.18.0",
    "lucide-react": "^0.344.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.21.0",
    "recharts": "^2.10.3",
    "uuid": "^13.0.0",
    "web-vitals": "^4.2.0",
    "web3": "^4.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/ui": "^1.0.0",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2",
    "vitest": "^1.0.0"
  }
}
